# AEGIS — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env with real secrets to version control.

# ── AI Server ──────────────────────────────────────────────
AEGIS_AI_GRPC_PORT=50051
AEGIS_AI_HOST=0.0.0.0
AEGIS_AI_MAX_WORKERS=10
AEGIS_AI_LOG_LEVEL=INFO

# ── Browser Server ─────────────────────────────────────────
AEGIS_BROWSER_GRPC_PORT=50052
AEGIS_BROWSER_HOST=0.0.0.0

# ── PC Server ──────────────────────────────────────────────
AEGIS_PC_GRPC_PORT=50053
AEGIS_PC_HOST=0.0.0.0

# ── Room Server ────────────────────────────────────────────
AEGIS_ROOM_GRPC_PORT=50054
AEGIS_ROOM_HOST=0.0.0.0

# ── Dev Server ─────────────────────────────────────────────
AEGIS_DEV_GRPC_PORT=50055
AEGIS_DEV_HOST=0.0.0.0

# ── Android Server (optional — runs on device, not in Docker) ──
# AEGIS_ANDROID_GRPC_PORT=50056

# ── AI Server ↔ Capability Servers ─────────────────────────
# These tell the AI Server where to find other servers.
# In Docker Compose, use service names (DNS resolution).
AEGIS_AI_GRPC_ADDR=ai-server:50051
AEGIS_BROWSER_GRPC_ADDR=browser-server:50052
AEGIS_PC_GRPC_ADDR=pc-server:50053
AEGIS_ROOM_GRPC_ADDR=room-server:50054
AEGIS_DEV_GRPC_ADDR=dev-server:50055

# ── LLM Provider (未実装 — placeholder) ─────────────────────
# AEGIS_LLM_PROVIDER=openai
# AEGIS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AEGIS_LLM_MODEL=gpt-4

# ── Secrets — NEVER set real values here ───────────────────
# Use Docker secrets or a vault in production.
# AEGIS_SECRET_KEY=change-me-in-production
