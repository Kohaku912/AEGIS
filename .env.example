# AEGIS Beta Environment Configuration
# Copy to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_VISION_API_KEY=sk-your-vision-api-key-here
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
AEGIS_MIN_LLM_INTERVAL_MS=1800000

# AGORA
AGORA_TOKEN=
AGORA_BASE_URL=https://agora.kakunin.me
AGORA_MASTER_USER=

# ── Server Ports ──────────────────────────────────────────
AEGIS_CORE_GRPC_PORT=50051
BROWSER_SERVER_PORT=50053
ROOM_SERVER_PORT=50055
DEV_SERVER_PORT=50056
AEGIS_DASHBOARD_PORT=8090
AEGIS_WEB_CHAT_PORT=8091
PC_SERVER_PORT=50052

# External/VPN access hints. Prefer VPN/private networking over public exposure.
AEGIS_PUBLIC_CORE_HOST=
AEGIS_PUBLIC_CORE_GRPC_PORT=50051
AEGIS_PUBLIC_DASHBOARD_URL=
AEGIS_DASHBOARD_ACCESS_TOKEN=

# ── PC Server (Windows Host) ─────────────────────────────
PC_SERVER_HOST=host.docker.internal
PC_SERVER_HOSTS=host.docker.internal
# Stable identity when DHCP changes the LAN IP (Wi-Fi and Ethernet MACs).
PC_SERVER_MACS=
PC_SERVER_PORT=50052
ANDROID_SERVER_HOST=host.docker.internal
ANDROID_SERVER_PORT=50054
AEGIS_ANDROID_PAIRING_TOKEN=

# Docker service DNS defaults used inside ai-server container
BROWSER_SERVER_HOST=browser-server
ROOM_SERVER_HOST=room-server
ROOM_SERVER_HOSTS=room-server,orangepi-room,orangepi-room.local
# Orange Pi eth/wlan MACs (comma-separated). Used to rediscover after DHCP changes.
ROOM_SERVER_MACS=
DEV_SERVER_HOST=dev-server

# When true (default for pc/room), probe the LAN /24 for the server port if
# configured hosts/MACs are unreachable after a DHCP lease change.
AEGIS_LAN_SCAN_ENABLED=true
AEGIS_LAN_SCAN_PREFIX=192.168.50
AEGIS_ENDPOINT_CACHE_PATH=data/endpoint_cache.json
AEGIS_NEIGHBOR_TABLE_PATH=data/neighbors.json

# ── Browser Settings ─────────────────────────────────────
AEGIS_BROWSER_HEADLESS=true
AEGIS_BROWSER_TIMEOUT_MS=30000

# Room Server
# Room light IR (Orange Pi Zero 3): PC11 = physical header pin 12 = gpiochip1 line 75
# AEGIS_ROOM_LIGHT_PROVIDER=gpio
# AEGIS_ROOM_IR_PIN=PC11
# Optional if LED drive is inverted through a transistor:
# AEGIS_ROOM_IR_ACTIVE_LOW=1
# INMP441 I2S mic via I2S3 (H618 Port H): L/R=GND, SCK=PH6 (23), WS=PH7 (19), SD=PH9 (24)
# Requires Armbian overlays=i2s3 (room-server/overlays/sun50i-h616-i2s3-inmp441.dts)
# AEGIS_ROOM_SOUND_PROVIDER=alsa
# AEGIS_ROOM_SOUND_ALSA_DEVICE=hw:ahubi2s3,0
AEGIS_ROOM_LIGHT_PROVIDER=mock
AEGIS_ROOM_IR_PIN=
AEGIS_ROOM_DEVICE_ID=light-main
AEGIS_ROOM_SOUND_PROVIDER=mock
AEGIS_ROOM_SOUND_ALSA_DEVICE=hw:ahubi2s3,0

# Dev Server
AEGIS_REPO_PATH=/workspace
GITHUB_TOKEN=

# ── Security ─────────────────────────────────────────────
# AEGIS_APPROVAL_TIMEOUT_MS=60000
# AEGIS_AUDIT_PATH=data/audit.jsonl
