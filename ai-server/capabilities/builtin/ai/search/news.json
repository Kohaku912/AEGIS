{
  "id": "ai.search.news",
  "title": "News Search",
  "description": "Search news using DuckDuckGo",
  "server_id": "ai",
  "app_id": "search",
  "action": "news",
  "risk": {
    "level": "read_only"
  },
  "input": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search query"
      },
      "max_results": {
        "type": "integer",
        "description": "Maximum number of results",
        "default": 5
      }
    },
    "required": ["query"]
  },
  "output": {
    "type": "object",
    "properties": {
      "query": { "type": "string" },
      "results": { "type": "array" },
      "count": { "type": "integer" }
    }
  },
  "tags": ["search", "news", "read"],
  "requires_approval": false
}
