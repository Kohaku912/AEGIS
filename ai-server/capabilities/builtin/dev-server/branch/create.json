      },
      "base_branch": {
        "type": "string",
        "default": "main"
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "repo_write",
      "git_branch"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "dev",
    "git",
    "write"
  ]
}