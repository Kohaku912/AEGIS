{
  "title": "Create Commit",
  "description": "Create a git commit in the Dev Server workspace.",
  "server_id": "dev-server",
  "app_id": "git",
  "action": "create_commit",
  "input_schema": {
    "type": "object",
    "required": ["message"],
    "properties": {
      "message": {"type": "string"},
      "files": {"type": "array", "items": {"type": "string"}, "default": []}
    }
  },
  "risk": {
    "level": "approval_required",
    "side_effects": ["repo_write", "git_commit"],
    "requires_approval": true
  },
  "tags": ["builtin", "dev", "git", "write"]
}
