{
  "title": "Revert Changes",
  "description": "Revert workspace changes or a commit in the Dev Server workspace.",
  "server_id": "dev-server",
  "app_id": "git",
  "action": "revert_changes",
  "operation_category": "delete",
  "input_schema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "default": "all"
      },
      "commit_hash": {
        "type": "string",
        "default": ""
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "repo_write",
      "file_delete",
      "git_revert"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "dev",
    "git",
    "write"
  ],
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
