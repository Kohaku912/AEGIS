{
  "title": "Create Pull Request",
  "description": "Create a pull request from a Dev Server branch.",
  "server_id": "dev-server",
  "app_id": "pr",
  "action": "create",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "required": [
      "title",
      "head_branch"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string",
        "default": ""
      },
      "head_branch": {
        "type": "string"
      },
      "base_branch": {
        "type": "string",
        "default": "main"
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "external_service",
      "repo_write",
      "pull_request"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "dev",
    "git",
    "pr",
    "write"
  ],
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
