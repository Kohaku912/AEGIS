{
  "title": "Test Result Summary",
  "description": "Read recent or lightweight test result information from the Dev Server.",
  "server_id": "dev-server",
  "app_id": "test",
  "action": "get_results",
  "operation_category": "read_only",
  "input_schema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "default": "ai-server"
      },
      "extra_args": {
        "type": "string",
        "default": ""
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "code_execution",
      "test_execution"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "dev",
    "test",
    "execute"
  ],
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
