{
  "title": "Run Lint",
  "description": "Run a linter inside the Dev Server workspace.",
  "server_id": "dev-server",
  "app_id": "lint",
  "action": "run_lint",
  "operation_category": "dev_operation",
  "input_schema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "default": "ai-server"
      },
      "linter": {
        "type": "string",
        "default": "ruff"
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "code_execution",
      "lint_execution"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "dev",
    "lint",
    "execute"
  ],
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
