{
  "title": "Android Screenshot",
  "description": "Capture the Android screen via MediaProjection.",
  "server_id": "android-server",
  "app_id": "screen",
  "action": "get_screenshot",
  "input_schema": {
    "type": "object",
    "properties": {
      "quality": {
        "type": "integer",
        "default": 80,
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "captures_screen"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "android",
    "screen",
    "screenshot",
    "privacy"
  ],
  "requires_permissions": [
    "media_projection"
  ],
  "extra": {
    "requires_permissions": [
      "media_projection"
    ]
  }
}