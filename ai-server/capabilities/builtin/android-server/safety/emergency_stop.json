{
  "title": "Android Emergency Stop",
  "description": "Stop active Android automation and clear pending Android commands.",
  "server_id": "android-server",
  "app_id": "safety",
  "action": "emergency_stop",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "reason": {
        "type": "string",
        "default": ""
      }
    }
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "stops_android_automation"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "android",
    "safety"
  ],
  "requires_permissions": [],
  "extra": {
    "requires_permissions": []
  },
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      },
      {
        "name": "command_id_present",
        "type": "output_field",
        "field": "command_id"
      }
    ]
  }
}
