{
  "title": "Request Android Approval",
  "description": "Display an approval request on the Android overlay as one approval surface.",
  "server_id": "android-server",
  "app_id": "approval",
  "action": "request",
  "operation_category": "notification",
  "input_schema": {
    "type": "object",
    "properties": {
      "approval_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "summary_json": {
        "type": "string"
      },
      "expires_at_ms": {
        "type": "integer"
      }
    },
    "required": [
      "approval_id",
      "title",
      "body"
    ]
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "android_overlay"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "android",
    "approval",
    "overlay"
  ],
  "requires_permissions": [
    "overlay"
  ],
  "extra": {
    "requires_permissions": [
      "overlay"
    ]
  },
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      },
      {
        "name": "command_id_present",
        "type": "output_field",
        "field": "command_id"
      }
    ]
  }
}
