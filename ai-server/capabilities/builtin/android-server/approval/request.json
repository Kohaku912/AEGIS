{
  "title": "Ask the User on Android",
  "description": "Display a confirmation prompt on the Android overlay and collect the user's answer. AEGIS chooses to ask; the answer informs the next step and unblocks nothing.",
  "server_id": "android-server",
  "app_id": "approval",
  "action": "request",
  "operation_category": "notification",
  "input_schema": {
    "type": "object",
    "properties": {
      "approval_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "summary_json": {
        "type": "string"
      }
    },
    "required": [
      "approval_id",
      "title",
      "body"
    ]
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "android_overlay"
    ],
    "requires_approval": false
  },
  "ownership_scope": "user",
  "reversibility": "recoverable",
  "destructive_effects": [],
  "data_loss_risk": "none",
  "active_work_loss_risk": "none",
  "blast_radius": "single",
  "tags": [
    "builtin",
    "android",
    "approval",
    "overlay"
  ],
  "requires_permissions": [
    "overlay"
  ],
  "extra": {
    "requires_permissions": [
      "overlay"
    ]
  },
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      },
      {
        "name": "command_id_present",
        "type": "output_field",
        "field": "command_id"
      }
    ]
  }
}
