{
  "title": "Open Android App",
  "description": "Open an Android application by package name.",
  "server_id": "android-server",
  "app_id": "app",
  "action": "open",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "package_name": {
        "type": "string"
      },
      "activity_name": {
        "type": "string",
        "default": ""
      }
    },
    "required": [
      "package_name"
    ]
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "opens_app"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "android",
    "app"
  ],
  "requires_permissions": [],
  "extra": {
    "requires_permissions": []
  },
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 250
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ui_tree_changed_after_action",
        "type": "ui_tree",
        "capability_id": "android-server.screen.get_ui_tree",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
