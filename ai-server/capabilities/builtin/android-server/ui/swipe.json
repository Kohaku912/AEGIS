{
  "title": "Android Swipe",
  "description": "Perform a swipe gesture via AccessibilityService.",
  "server_id": "android-server",
  "app_id": "ui",
  "action": "swipe",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "start_x": {
        "type": "integer"
      },
      "start_y": {
        "type": "integer"
      },
      "end_x": {
        "type": "integer"
      },
      "end_y": {
        "type": "integer"
      },
      "duration_ms": {
        "type": "integer",
        "default": 300
      }
    },
    "required": [
      "start_x",
      "start_y",
      "end_x",
      "end_y"
    ]
  },
  "risk": {
    "level": "audited_action",
    "side_effects": [
      "touch_input"
    ],
    "requires_approval": false,
    "approval_mode": "explicit"
  },
  "ownership_scope": "user",
  "reversibility": "difficult",
  "destructive_effects": [],
  "data_loss_risk": "none",
  "active_work_loss_risk": "low",
  "blast_radius": "single",
  "tags": [
    "builtin",
    "android",
    "ui",
    "input"
  ],
  "requires_permissions": [
    "accessibility"
  ],
  "extra": {
    "requires_permissions": [
      "accessibility"
    ]
  },
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 250
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ui_tree_changed_after_action",
        "type": "ui_tree",
        "capability_id": "android-server.screen.get_ui_tree",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
