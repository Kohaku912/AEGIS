{
  "title": "Android Type Text",
  "description": "Type text into the current Android focused field via AccessibilityService.",
  "server_id": "android-server",
  "app_id": "ui",
  "action": "type_text",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "keyboard_input"
    ],
    "requires_approval": false
  },
  "tags": [
    "builtin",
    "android",
    "ui",
    "input",
    "text"
  ],
  "requires_permissions": [
    "accessibility"
  ],
  "extra": {
    "requires_permissions": [
      "accessibility"
    ]
  },
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 250
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ui_tree_changed_after_type",
        "type": "ui_tree",
        "capability_id": "android-server.screen.get_ui_tree",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}