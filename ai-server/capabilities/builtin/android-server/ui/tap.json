{
  "title": "Android Tap",
  "description": "Tap Android screen coordinates via AccessibilityService.",
  "server_id": "android-server",
  "app_id": "ui",
  "action": "tap",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "x": {
        "type": "integer"
      },
      "y": {
        "type": "integer"
      },
      "duration_ms": {
        "type": "integer",
        "default": 0
      }
    },
    "required": [
      "x",
      "y"
    ]
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "touch_input"
    ],
    "requires_approval": false,
    "approval_mode": "explicit"
  },
  "tags": [
    "builtin",
    "android",
    "ui",
    "input"
  ],
  "requires_permissions": [
    "accessibility"
  ],
  "extra": {
    "requires_permissions": [
      "accessibility"
    ]
  },
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 250
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ui_tree_changed_after_tap",
        "type": "ui_tree",
        "capability_id": "android-server.screen.get_ui_tree",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
