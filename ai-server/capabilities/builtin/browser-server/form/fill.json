{
  "title": "Fill web form",
  "description": "Fill a declared web form. Approval protects personal or secret data from unattended entry.",
  "operation_category": "data_entry",
  "risk": {
    "level": "safe",
    "side_effects": [
      "form_data_entry"
    ],
    "requires_approval": false
  },
  "ownership_scope": "user",
  "only_master": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "task": {
        "type": "string"
      },
      "viewer": {
        "type": "string",
        "enum": [
          "agent_private",
          "shared"
        ]
      },
      "purpose": {
        "type": "string",
        "enum": [
          "automate",
          "collaborative_review"
        ]
      },
      "success_condition": {
        "type": "string"
      },
      "stop_condition": {
        "type": "string"
      },
      "max_steps": {
        "type": "integer",
        "default": 15
      }
    },
    "required": [
      "task",
      "viewer",
      "purpose",
      "success_condition",
      "stop_condition"
    ]
  },
  "completion": {
    "mode": "all",
    "checks": [
      {
        "name": "browser_completed",
        "type": "output_field",
        "field": "status",
        "equals": "COMPLETED"
      }
    ]
  }
}
