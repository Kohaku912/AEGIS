{
  "title": "Upload file to website",
  "description": "Upload a declared file to an external website after approval.",
  "operation_category": "external_send",
  "risk": {
    "level": "audited_action",
    "side_effects": [
      "file_upload"
    ],
    "requires_approval": false
  },
  "ownership_scope": "external",
  "only_master": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "task": {
        "type": "string"
      },
      "viewer": {
        "type": "string",
        "enum": [
          "agent_private",
          "shared"
        ]
      },
      "purpose": {
        "type": "string",
        "enum": [
          "automate",
          "collaborative_review"
        ]
      },
      "success_condition": {
        "type": "string"
      },
      "stop_condition": {
        "type": "string"
      },
      "max_steps": {
        "type": "integer",
        "default": 20
      }
    },
    "required": [
      "task",
      "viewer",
      "purpose",
      "success_condition",
      "stop_condition"
    ]
  },
  "completion": {
    "mode": "all",
    "checks": [
      {
        "name": "browser_completed",
        "type": "output_field",
        "field": "status",
        "equals": "COMPLETED"
      }
    ]
  }
}
