{
  "title": "Show Rich Display Overlay",
  "description": "Display a PC overlay with title, text, and an optional base64 image.",
  "server_id": "pc-server",
  "app_id": "overlay",
  "action": "show_rich",
  "operation_category": "notification",
  "risk": {"level": "safe", "side_effects": ["pc_overlay"], "requires_approval": false},
  "tags": ["overlay", "display", "image", "safe"],
  "only_master": false,
  "tcp_command_json": "show_rich_overlay",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {"type": "string", "default": "AEGIS"},
      "body": {"type": "string"},
      "duration_seconds": {"type": "integer", "default": 8},
      "style": {"type": "string", "default": "info"},
      "image_base64": {"type": "string"},
      "image_mime": {"type": "string"}
    },
    "required": ["body"]
  }
}
