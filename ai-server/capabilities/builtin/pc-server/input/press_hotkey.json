{
  "title": "Press Hotkey",
  "description": "Press a keyboard shortcut.",
  "server_id": "pc-server",
  "app_id": "input",
  "action": "press_hotkey",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "keys": {
        "type": "string"
      }
    },
    "required": [
      "keys"
    ]
  },
  "risk": {
    "level": "medium",
    "side_effects": [
      "ui_interaction"
    ],
    "requires_approval": true
  },
  "tags": [
    "builtin",
    "pc",
    "action",
    "keyboard"
  ],
  "tcp_command": "press_hotkey {keys}",
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 200
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "screen_changed_after_action",
        "type": "screenshot",
        "capability_id": "pc-server.screenshot.get_screenshot",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
