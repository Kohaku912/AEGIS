{
  "title": "Mouse Click",
  "description": "Click at a specific screen position.",
  "server_id": "pc-server",
  "app_id": "input",
  "action": "mouse_click",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "x": {"type": "integer"},
      "y": {"type": "integer"},
      "button": {"type": "string", "default": "left"}
    },
    "required": ["x", "y"]
  },
  "risk": {"level": "medium", "side_effects": ["ui_interaction"], "requires_approval": true},
  "tags": ["builtin", "pc", "action", "mouse"],
  "completion": {
    "mode": "all",
    "retry": {"max_attempts": 1, "delay_ms": 200},
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "screen_changed_after_click",
        "type": "screenshot",
        "capability_id": "pc-server.screenshot.get_screenshot",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  },
  "tcp_command": "mouse_click {x},{y},{button}"
}
