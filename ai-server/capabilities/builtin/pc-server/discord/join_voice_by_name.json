{
  "title": "Discord Join Voice By Name",
  "description": "Join a Discord voice channel by server/guild name and optional channel name. Use this for requests like 「memoサーバーの通話に入って」 by passing guild_name as memo and channel_name only when the user specifies one. Requires approval.",
  "server_id": "pc-server",
  "app_id": "discord",
  "action": "join_voice_by_name",
  "operation_category": "external_send",
  "input_schema": {
    "type": "object",
    "properties": {
      "guild_name": {
        "type": "string",
        "description": "Discord server/guild name to match, for example memo"
      },
      "channel_name": {
        "type": "string",
        "description": "Optional voice channel name. Leave empty if the user only asked for the server's call."
      }
    },
    "required": [
      "guild_name"
    ]
  },
  "risk": {
    "level": "medium",
    "requires_approval": true,
    "side_effects": [
      "external_service_operation",
      "discord_voice_call_join",
      "presence_change"
    ]
  },
  "tags": [
    "discord",
    "voice",
    "call",
    "guild",
    "approval_required"
  ],
  "examples": [
    {
      "user": "memoサーバーの通話に入って",
      "arguments": {
        "guild_name": "memo"
      }
    }
  ],
  "tcp_command_json": "discord_join_voice_by_name",
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      }
    ]
  }
}