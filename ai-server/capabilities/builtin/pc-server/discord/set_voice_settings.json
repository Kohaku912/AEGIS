  "app_id": "discord",
  "action": "set_voice_settings",
  "operation_category": "external_send",
  "input_schema": {
    "type": "object",
    "properties": {
      "mute": {
        "type": "boolean"
      },
      "deaf": {
        "type": "boolean"
      }
    }
  },
  "risk": {
    "level": "safe",
    "requires_approval": false,
    "side_effects": [
