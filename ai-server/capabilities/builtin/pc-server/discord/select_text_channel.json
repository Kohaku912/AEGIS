{
  "title": "Discord Select Text Channel",
  "description": "Select a Discord text channel in the desktop client by channel id. Does not send a message. Requires approval because it changes the external app state.",
  "server_id": "pc-server",
  "app_id": "discord",
  "action": "select_text_channel",
  "operation_category": "external_send",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "description": "Discord text channel id"
      }
    },
    "required": [
      "channel_id"
    ]
  },
  "risk": {
    "level": "safe",
    "requires_approval": false,
    "side_effects": [
      "external_service_operation",
      "discord_ui_selection"
    ]
  },
  "tags": [
    "discord",
    "text_channel",
    "approval_required"
  ],
  "tcp_command_json": "discord_select_text_channel",
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      }
    ]
  }
}
