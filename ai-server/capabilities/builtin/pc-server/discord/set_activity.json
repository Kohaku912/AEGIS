{
  "title": "Discord Set Activity",
  "description": "Set Discord rich presence/activity through Discord RPC when permitted by the desktop client. It changes public presence, so AEGIS may choose to confirm with the user first.",
  "server_id": "pc-server",
  "app_id": "discord",
  "action": "set_activity",
  "operation_category": "external_send",
  "input_schema": {
    "type": "object",
    "properties": {
      "activity": {
        "type": "object",
        "description": "Discord RPC activity payload"
      }
    },
    "required": [
      "activity"
    ]
  },
  "risk": {
    "level": "safe",
    "requires_approval": false,
    "side_effects": [
      "external_service_operation",
      "discord_presence_change"
    ]
  },
  "ownership_scope": "external",
  "reversibility": "recoverable",
  "destructive_effects": [],
  "data_loss_risk": "none",
  "active_work_loss_risk": "none",
  "blast_radius": "single",
  "tags": [
    "discord",
    "activity",
    "presence",
    "approval_required"
  ],
  "tcp_command_json": "discord_set_activity",
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      }
    ]
  }
}
