{
  "id": "pc-server.service.stop",
  "title": "Stop Service",
  "description": "Stop a Windows service (requires approval)",
  "server_id": "pc-server",
  "app_id": "service",
  "action": "stop",
  "operation_category": "general",
  "risk": {
    "level": "safe"
  },
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Service name"
      }
    },
    "required": [
      "name"
    ]
  },
  "tags": [
    "service",
    "stop",
    "approval_required"
  ],
  "tcp_command": "stop_service {name}",
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      },
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      }
    ]
  }
}
