{
  "title": "Launch App",
  "description": "Launch an application.",
  "server_id": "pc-server",
  "app_id": "system",
  "action": "launch_app",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "app_path": {
        "type": "string"
      }
    },
    "required": [
      "app_path"
    ]
  },
  "risk": {
    "level": "safe",
    "side_effects": [
      "process_start"
    ],
    "requires_approval": false
  },
  "ownership_scope": "user",
  "reversibility": "recoverable",
  "destructive_effects": [],
  "data_loss_risk": "none",
  "active_work_loss_risk": "none",
  "blast_radius": "single",
  "tags": [
    "builtin",
    "pc",
    "action",
    "app"
  ],
  "tcp_command": "launch_app {app_path}",
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 200
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "screen_changed_after_action",
        "type": "screenshot",
        "capability_id": "pc-server.screenshot.get_screenshot",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
