{
  "title": "Close Window",
  "description": "Close a window by ID or process name.",
  "server_id": "pc-server",
  "app_id": "window",
  "action": "close_window",
  "operation_category": "general",
  "input_schema": {
    "type": "object",
    "properties": {
      "window_id": {
        "type": "string"
      },
      "process_name": {
        "type": "string"
      }
    }
  },
  "risk": {
    "level": "medium",
    "side_effects": [
      "process_terminate"
    ],
    "requires_approval": true
  },
  "tags": [
    "builtin",
    "pc",
    "action",
    "window"
  ],
  "tcp_command": "close_window {title}",
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 200
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "screen_changed_after_action",
        "type": "screenshot",
        "capability_id": "pc-server.screenshot.get_screenshot",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
