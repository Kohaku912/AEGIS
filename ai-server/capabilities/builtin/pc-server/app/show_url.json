{
  "id": "pc-server.app.show_url",
  "title": "ウェブサイトをユーザーに見せる",
  "description": "Open a URL on the user's PC only for an explicit user-visible or shared handoff. Agent-private research uses a purpose-specific browser-server read capability.",
  "server_id": "pc-server",
  "app_id": "app",
  "action": "show_url",
  "operation_category": "general",
  "risk": {
    "level": "safe",
    "requires_approval": false
  },
  "input": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "URL to show to the user"
      },
      "viewer": {
        "type": "string",
        "enum": [
          "user_visible",
          "shared"
        ],
        "description": "Who must see the page"
      },
      "purpose": {
        "type": "string",
        "enum": [
          "present_to_user",
          "request_manual_action",
          "collaborative_review"
        ],
        "description": "Why the page is being handed to the user"
      }
    },
    "required": [
      "url",
      "viewer",
      "purpose"
    ]
  },
  "tags": [
    "browser",
    "url",
    "show",
    "user_visible",
    "presentation"
  ],
  "examples": [
    {
      "user": "この記事を見せて",
      "arguments": {
        "url": "https://example.com/article"
      }
    },
    {
      "user": "さっき調べたサイトを開いて",
      "arguments": {
        "url": "https://example.com"
      }
    }
  ],
  "tcp_command": "open_url {url}"
}
