{
  "id": "pc-server.shell.powershell",
  "title": "Execute PowerShell",
  "description": "Execute a PowerShell command (executes with audit)",
  "server_id": "pc-server",
  "app_id": "shell",
  "action": "powershell",
  "operation_category": "general",
  "risk": {
    "level": "high",
    "requires_approval": false
  },
  "ownership_scope": "system",
  "reversibility": "irreversible",
  "destructive_effects": ["file_delete", "data_overwrite", "process_terminate", "permission_change"],
  "data_loss_risk": "high",
  "active_work_loss_risk": "high",
  "blast_radius": "system_wide",
  "input": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "description": "PowerShell command"
      },
      "working_dir": {
        "type": "string",
        "description": "Working directory"
      }
    },
    "required": [
      "command"
    ]
  },
  "tags": [
    "shell",
    "powershell",
    "audited_action"
  ],
  "tcp_command": "execute_powershell {command}|{working_dir}",
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
