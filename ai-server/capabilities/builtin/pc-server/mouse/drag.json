{
  "id": "pc-server.mouse.drag",
  "title": "Mouse Drag",
  "description": "Drag mouse from one position to another (requires approval)",
  "server_id": "pc-server",
  "app_id": "mouse",
  "action": "drag",
  "operation_category": "general",
  "risk": {
    "level": "safe"
  },
  "input": {
    "type": "object",
    "properties": {
      "from_x": {
        "type": "integer"
      },
      "from_y": {
        "type": "integer"
      },
      "to_x": {
        "type": "integer"
      },
      "to_y": {
        "type": "integer"
      }
    },
    "required": [
      "from_x",
      "from_y",
      "to_x",
      "to_y"
    ]
  },
  "tags": [
    "mouse",
    "input",
    "approval_required"
  ],
  "tcp_command": "mouse_drag {from_x},{from_y},{to_x},{to_y}",
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 1,
      "delay_ms": 200
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "screen_changed_after_action",
        "type": "screenshot",
        "capability_id": "pc-server.screenshot.get_screenshot",
        "expect_changed": true,
        "capture_before": true
      }
    ]
  }
}
