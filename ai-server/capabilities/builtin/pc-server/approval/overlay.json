{
  "id": "pc-server.approval.overlay",
  "title": "Overlay Approval",
  "description": "Show overlay approval dialog with Y/N key input",
  "server_id": "pc-server",
  "app_id": "approval",
  "action": "overlay",
  "operation_category": "notification",
  "risk": {
    "level": "safe",
    "requires_approval": false
  },
  "ownership_scope": "user",
  "reversibility": "recoverable",
  "destructive_effects": [],
