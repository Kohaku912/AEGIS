  "input": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "Action to approve"
      },
      "timeout": {
        "type": "integer",
        "description": "Timeout in seconds",
        "default": 30
      }
    },
    "required": [
      "action"
    ]
  },
  "tags": [
    "overlay",
    "approval"
  ],
  "tcp_command": "overlay_approval {action}"
}
