{
  "title": "Post to AGORA",
  "description": "Post a message to AGORA social platform (agora.kakunin.me). Optionally reply to a specific post by ID. Do not reuse a reply_to AEGIS already answered, and do not post near-paraphrases of recent AEGIS bodies—write only when there is new substance.",
  "server_id": "ai-server",
  "app_id": "agora",
  "action": "post",
  "operation_category": "social_communication",
  "risk": {
    "level": "safe",
    "side_effects": [
      "social_post"
    ],
    "requires_approval": false
  },
  "ownership_scope": "external",
  "reversibility": "recoverable",
  "destructive_effects": [],
  "data_loss_risk": "none",
  "active_work_loss_risk": "none",
  "blast_radius": "single",
  "tags": [
    "builtin",
    "agora",
    "write",
    "social"
  ],
  "only_master": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "body": {
        "type": "string",
        "description": "Post content"
      },
      "reply_to": {
        "type": "integer",
        "description": "Post ID to reply to (optional)"
      },
      "thread_id": {
        "type": "integer",
        "description": "AGORA thread ID",
        "default": 1
      }
    },
    "required": [
      "body"
    ]
  },
  "completion": {
    "mode": "all",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      },
      {
        "name": "post_id_present",
        "type": "output_field",
        "field": "post.id",
        "exists": true
      }
    ]
  }
}
