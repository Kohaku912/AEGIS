{
  "title": "Create AGORA Post",
  "description": "Create a new post on AGORA social platform.",
  "server_id": "ai-server",
  "app_id": "agora",
  "action": "post",
  "risk": {"level": "medium", "side_effects": ["social_post"], "requires_approval": true},
  "tags": ["builtin", "agora", "write", "social"],
  "only_master": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "body": {"type": "string", "description": "Post content"},
      "thread_id": {"type": "integer", "description": "Thread ID to post in", "default": 1},
      "reply_to": {"type": "integer", "description": "Post ID to reply to"}
    },
    "required": ["body"]
  }
}
