{
  "title": "Transition Commitment",
  "description": "Mark a commitment completed, failed, postponed, or cancelled.",
  "server_id": "ai-server",
  "app_id": "commitment",
  "action": "transition",
  "operation_category": "commitment_management",
  "risk": {
    "level": "safe",
    "side_effects": [
      "commitment_write"
    ],
    "requires_approval": false
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "commitment_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "postpone_until_ms": {
        "type": "integer"
      }
    },
    "required": [
      "commitment_id",
      "status"
    ]
  },
  "tags": [
    "commitment",
    "personal-ai",
    "write"
  ],
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      },
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
