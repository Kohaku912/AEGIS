{
  "title": "Create Social Draft",
  "description": "Create a draft for webhook or email. This does not send anything.",
  "server_id": "ai-server",
  "app_id": "social",
  "action": "create_draft",
  "risk": {"level": "safe", "side_effects": ["draft_write"], "requires_approval": false},
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {"type": "string", "enum": ["webhook", "email", "discord", "line", "agora"]},
      "to": {"type": "string"},
      "subject": {"type": "string"},
      "body": {"type": "string"},
      "payload": {"type": "object"}
    },
    "required": ["channel", "body"]
  },
  "tags": ["social", "draft", "personal-ai"]
}
