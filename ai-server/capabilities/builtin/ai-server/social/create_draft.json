{
  "title": "Create Social Draft",
  "description": "Create a draft for webhook or email. This does not send anything.",
  "server_id": "ai-server",
  "app_id": "social",
  "action": "create_draft",
  "operation_category": "draft_create",
  "risk": {
    "level": "safe",
    "side_effects": [
      "draft_write"
    ],
    "requires_approval": false
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "enum": [
          "webhook",
          "email",
          "discord",
          "line",
          "agora"
        ]
      },
      "to": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "payload": {
        "type": "object"
      }
    },
    "required": [
      "channel",
      "body"
    ]
  },
  "tags": [
    "social",
    "draft",
    "personal-ai"
  ],
  "completion": {
    "mode": "any",
    "retry": {
      "max_attempts": 0,
      "delay_ms": 0
    },
    "on_failure": "retry_or_user_confirmation",
    "checks": [
      {
        "name": "ok_true",
        "type": "output_field",
        "field": "ok",
        "equals": true
      },
      {
        "name": "success_true",
        "type": "output_field",
        "field": "success",
        "equals": true
      }
    ]
  }
}
