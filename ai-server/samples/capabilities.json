[
  {
    "id": "pc.screenshot",
    "name": "Screenshot Capture",
    "description": "Capture a screenshot of the current display. Returns a PNG image encoded as base64.",
    "server_type": 2,
    "input_schema": "{\"type\":\"object\",\"properties\":{\"display_id\":{\"type\":\"integer\",\"description\":\"Display index (0 = primary)\",\"default\":0},\"format\":{\"type\":\"string\",\"enum\":[\"png\",\"jpeg\"],\"default\":\"png\"},\"quality\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":100,\"default\":90}},\"required\":[]}",
    "output_schema": "{\"type\":\"object\",\"properties\":{\"image_base64\":{\"type\":\"string\",\"description\":\"Base64-encoded image data\"},\"width\":{\"type\":\"integer\"},\"height\":{\"type\":\"integer\"},\"format\":{\"type\":\"string\"}},\"required\":[\"image_base64\",\"width\",\"height\"]}",
    "risk_level": 1,
    "requires_approval": false,
    "side_effects": [],
    "timeout_ms": 5000,
    "tags": ["screenshot", "observe", "ui", "ocr", "risk:read_only"],
    "version": "0.1.0"
  },
  {
    "id": "pc.mouse_click",
    "name": "Mouse Click",
    "description": "Perform a mouse click at the specified screen coordinates. Supports left, right, and middle clicks with optional double-click.",
    "server_type": 2,
    "input_schema": "{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"integer\",\"description\":\"X coordinate (pixels)\"},\"y\":{\"type\":\"integer\",\"description\":\"Y coordinate (pixels)\"},\"button\":{\"type\":\"string\",\"enum\":[\"left\",\"right\",\"middle\"],\"default\":\"left\"},\"double\":{\"type\":\"boolean\",\"default\":false}},\"required\":[\"x\",\"y\"]}",
    "output_schema": "{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"}},\"required\":[\"success\"]}",
    "risk_level": 2,
    "requires_approval": false,
    "side_effects": ["modifies UI state", "may trigger unintended actions"],
    "timeout_ms": 3000,
    "tags": ["mouse", "input", "action", "ui", "risk:safe_action"],
    "version": "0.1.0"
  },
  {
    "id": "pc.keyboard_type",
    "name": "Keyboard Type",
    "description": "Type a string of text via simulated keyboard input. Supports special keys via {key} syntax.",
    "server_type": 2,
    "input_schema": "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"Text to type (supports {enter}, {tab}, {escape} etc.)\"},\"delay_ms\":{\"type\":\"integer\",\"description\":\"Delay between keystrokes (ms)\",\"default\":10}},\"required\":[\"text\"]}",
    "output_schema": "{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"characters_typed\":{\"type\":\"integer\"}},\"required\":[\"success\"]}",
    "risk_level": 2,
    "requires_approval": false,
    "side_effects": ["inputs text into active application", "may trigger keyboard shortcuts"],
    "timeout_ms": 10000,
    "tags": ["keyboard", "input", "action", "ui", "risk:safe_action"],
    "version": "0.1.0"
  },
