{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "AEGIS Spatial Information Design",
  "version": "3.0.0",
  "color": {
    "background": {"value": "#05090F"},
    "surface": {"value": "#0B111B"},
    "surfaceElevated": {"value": "#111A27"},
    "surfaceMuted": {"value": "#162133"},
    "border": {"value": "#1E2A3A"},
    "textPrimary": {"value": "#EAF2FF"},
    "textSecondary": {"value": "#8EA0B8"},
    "textMuted": {"value": "#5F718B"},
    "aegisCyan": {"value": "#29D3FF"},
    "cognitiveViolet": {"value": "#8B7CFF"},
    "actionBlue": {"value": "#3D8BFF"},
    "memoryIndigo": {"value": "#A66CFF"},
    "communicationRose": {"value": "#FF7AA8"},
    "infrastructureTeal": {"value": "#31C7B5"},
    "policyAmber": {"value": "#FFB84D"},
    "success": {"value": "#2DD4A8"},
    "warning": {"value": "#FFB84D"},
    "critical": {"value": "#FF5D73"},
    "offline": {"value": "#7C8798"},
    "white": {"value": "#FFFFFF"}
  },
  "radius": {
    "sm": {"value": "6px"},
    "md": {"value": "8px"},
    "lg": {"value": "12px"},
    "xl": {"value": "16px"}
  },
  "spacing": {
    "xs": {"value": "4px"},
    "sm": {"value": "8px"},
    "md": {"value": "12px"},
    "lg": {"value": "16px"},
    "xl": {"value": "24px"},
    "xxl": {"value": "32px"}
  },
  "motion": {
    "fast": {"value": "120ms"},
    "normal": {"value": "220ms"},
    "slow": {"value": "420ms"},
    "breath": {"value": "8000ms"},
    "ambient": {"value": "16000ms"},
    "observe": {"value": "750ms"},
    "plan": {"value": "1500ms"},
    "failure": {"value": "650ms"},
    "recovery": {"value": "2400ms"}
  },
  "depth": {
    "environment": {"value": "-1200"},
    "memory": {"value": "-800"},
    "topology": {"value": "-450"},
    "mission": {"value": "0"},
    "execution": {"value": "250"},
    "attention": {"value": "500"},
    "takeover": {"value": "900"}
  },
  "typography": {
    "fontFamily": {"value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"},
    "monoFamily": {"value": "JetBrains Mono, ui-monospace, SFMono-Regular, Consolas, monospace"}
  },
  "state": {
    "online": {"label": "ONLINE", "color": "{color.success.value}", "icon": "check-circle"},
    "degraded": {"label": "DEGRADED", "color": "{color.warning.value}", "icon": "alert-triangle"},
    "offline": {"label": "OFFLINE", "color": "{color.critical.value}", "icon": "circle-off"},
    "disabled": {"label": "DISABLED", "color": "{color.offline.value}", "icon": "pause-circle"},
    "approval": {"label": "WAITING FOR APPROVAL", "color": "{color.warning.value}", "icon": "shield-alert"},
    "critical": {"label": "CRITICAL", "color": "{color.critical.value}", "icon": "siren"}
  },
  "risk": {
    "safe": {"label": "SAFE", "color": "{color.success.value}"},
    "low": {"label": "LOW", "color": "{color.aegisCyan.value}"},
    "medium": {"label": "MEDIUM", "color": "{color.warning.value}"},
    "high": {"label": "HIGH", "color": "{color.critical.value}"},
    "forbidden": {"label": "FORBIDDEN", "color": "{color.critical.value}"}
  }
}
