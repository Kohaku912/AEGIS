[Unit]
Description=AEGIS dedicated display idle power controller
After=aegis-kiosk.service
Requires=aegis-kiosk.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=AEGIS_DISPLAY_OVERVIEW_URL=http://127.0.0.1:8090/display/overview
Environment=AEGIS_DISPLAY_IDLE_SECONDS=600
ExecStart=/usr/bin/python3 /opt/aegis/scripts/display/aegis-display-power-watch.py
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
