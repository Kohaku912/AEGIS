AEGIS_RUNTIME_MODE=production
AEGIS_AUTH_MODE=passkey
AEGIS_PRODUCTION_BIND_HOST=127.0.0.1
AEGIS_WEBAUTHN_RP_ID=example.com
AEGIS_WEBAUTHN_RP_NAME=AEGIS Dashboard
AEGIS_WEBAUTHN_ORIGINS=https://example.com
AEGIS_SESSION_SECRET=change-me-long-random-session-secret
AEGIS_AUTH_BOOTSTRAP_TOKEN=change-me-one-time-bootstrap-token
# Legacy token is bootstrap/recovery only. It is not accepted for normal login in production.
AEGIS_DASHBOARD_ACCESS_TOKEN=
AEGIS_ANDROID_PAIRING_TOKEN=change-me-long-random-token
LLM_API_KEY=
# TypeSafe JEV is the LLM behind L1 (config/llm.yaml -> profiles.l1_default:
# provider=typesafe, model=jev-latest, api_key_env=TYPESAFE_API_KEY). L1 runs on
# every routed event. Without this key the gateway builds a TypeSafe provider with
# an EMPTY key, every call fails, and every event escalates to L2 -- so L1 cannot
# classify at all. Required whenever L1 is expected to run.
TYPESAFE_API_KEY=

# Enable only when a real room provider is attached.
# COMPOSE_PROFILES=room
# AEGIS_ROOM_LIGHT_PROVIDER=gpio
# AEGIS_ROOM_IR_PIN=
